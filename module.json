{
  "manifest_version": 2,
  "id": "nexicturbo/sentry-incident-ops",
  "name": "Sentry Incident Operations Airlock",
  "version": "0.1.2",
  "provider": "sentry",
  "description": "Operate Sentry issue response without giving an agent an unattended production write path. Six bounded, privacy-minimized reads expose the incident context responders need; four mutations require RailCall approval, fetch live state immediately before execution, refuse stale approvals, verify the result after writing, and emit a deterministic SHA-256 safety proof. The token comes only from RailCall's vault. Network access is fixed to sentry.io, subprocesses and filesystem writes are disabled, responses omit structured user/email fields and raw event payloads, and Sentry failures are surfaced honestly. contest:2026Q3",
  "auth": {
    "type": "api_key",
    "vault_provider": "sentry",
    "field": "SENTRY_AUTH_TOKEN"
  },
  "credential_spec": {
    "provider": "sentry",
    "category": "observability",
    "name": "Sentry",
    "required": [
      "SENTRY_AUTH_TOKEN"
    ],
    "optional": [],
    "shape": "dict",
    "risk": "high",
    "read_write": "write"
  },
  "requires": {
    "network": [
      "sentry.io"
    ],
    "subprocess": false,
    "filesystem_writes": []
  },
